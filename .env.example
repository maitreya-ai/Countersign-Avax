# Copy to .env (git-ignored). `bun run scripts/gen-keys.ts` fills the keys for you.

# --- chain (Avalanche Fuji C-Chain) ---
CHAIN_ID=43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
EXPLORER=https://testnet.snowtrace.io
USDC=0x5425890298aed601595a70AB815c96711a31Bc65
ERC8004_IDENTITY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_VALIDATION=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# --- keys (never commit) ---
DEPLOYER_PRIVATE_KEY=          # deploys, owns SignerRegistry, runs the keeper/facilitator (needs AVAX)
ATTESTER_PRIVATE_KEY=          # root of the self-attested judge keys (no funds)
AGENT_PRIVATE_KEY=             # demo buyer (needs test USDC only, never AVAX)
SELLER_HONEST_PRIVATE_KEY=     # sellers need a little AVAX once, to register their ERC-8004 identity
SELLER_LAZY_PRIVATE_KEY=
SELLER_INJECTOR_PRIVATE_KEY=
SELLER_SWAPPER_PRIVATE_KEY=

# --- judges: two distinct models + grounding + calibration ---
GROQ_API_KEY=
GEMINI_API_KEY=
JUDGES=2
JUDGE_A=groq:openai/gpt-oss-120b
JUDGE_B=groq:qwen/qwen3-32b
GROUNDING=groq:openai/gpt-oss-120b
CALIBRATION=groq:qwen/qwen3-32b
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1   # for local:<model> judges (Ollama, LM Studio, scripts/mock-llm.ts)

# --- deployed (written by scripts/deploy.sh and scripts/register-sellers.ts) ---
SIGNER_REGISTRY=
ASSAY_ORACLE=
ASSAY_ESCROW=
ASSAY_VALIDATOR=

# --- services ---
NODE_PORT=8402
NODE_URL=http://localhost:8402
SELLERS_PORT=8403
SELLERS_URL=http://localhost:8403
SUMMARY_PRICE_USDC=0.25
JUDGE_PRICE_USDC=0.05
DEADLINE_SECONDS=900
FACILITATOR_EXACT=local        # local | payai
DEMO_ENABLED=1                 # lets the dashboard trigger rate-limited demo purchases
