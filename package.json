{
  "name": "countersign",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "demo/*",
    "web"
  ],
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc -p packages/x402-countersign && tsc -p packages/core && tsc -p services/node && tsc -p services/node/tsconfig.worker.json && tsc -p demo/sellers && tsc -p demo/agent && tsc -p tests && cd web && tsc --noEmit -p .",
    "test": "bun run test:unit && bun run test:contracts && bun run test:e2e",
    "test:unit": "bun test packages",
    "test:contracts": "cd contracts && forge test",
    "test:e2e": "bun test tests/e2e/wiring.test.ts",
    "test:live": "bun test tests/e2e/live.test.ts",
    "node": "bun run services/node/src/index.ts",
    "sellers": "bun run demo/sellers/src/serve.ts",
    "agent": "bun run demo/agent/buy.ts",
    "web": "cd web && bun run dev",
    "build:web": "cd web && bun run build",
    "deploy": "bun run build:web && wrangler deploy",
    "cf:types": "wrangler types services/node/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "husky": "^9",
    "typescript": "^5.6.0",
    "wrangler": "4.79.0"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "@countersign/x402": "workspace:*",
    "@countersign/core": "workspace:*"
  }
}
