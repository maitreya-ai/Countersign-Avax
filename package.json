{
  "name": "countersign",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "demo/*",
    "web"
  ],
  "scripts": {
    "test": "bun test packages",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "bunx tsc -p packages/x402-countersign && bunx tsc -p packages/core && bunx tsc -p services/node",
    "node": "bun run services/node/src/index.ts",
    "sellers": "bun run demo/sellers/src/index.ts",
    "agent": "bun run demo/agent/buy.ts",
    "web": "cd web && bun run dev"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "@countersign/x402": "workspace:*",
    "@countersign/core": "workspace:*"
  }
}
